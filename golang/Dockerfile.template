# --- Stage 1: Environment Provisioning & Metadata ---
# Leverage build-time arguments for the base image to maximize configuration flexibility
FROM ${v_base_image}

# Image Metadata: Establishes ownership, runtime context, and repository traceability
LABEL author="xwi88" \
      type="go" \
      maintainer="278810732@qq.com" \
      github="https://github.com/xwi88" \
      group="https://github.com/v8fg"

# --- Stage 2: System Optimization & Dependencies ---
# Execute system updates and install core build utilities:
# - tzdata: For timezone synchronization
# - git/make/bash: Essential toolchain for Go build automation
# --no-cache: Minimizes image footprint by excluding local package index persistence
RUN apk add --no-cache tzdata git make bash
